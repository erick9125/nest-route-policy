{
  "name": "@erickmorales/nest-route-policy",
  "version": "0.1.0",
  "description": "Declarative resource-level authorization for NestJS with ownership, roles, scopes, tenant context, and extensible policy evaluation.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/esm/nest/index.d.ts",
        "default": "./dist/esm/nest/index.js"
      },
      "require": {
        "types": "./dist/cjs/nest/index.d.ts",
        "default": "./dist/cjs/nest/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && node scripts/finalize-build.mjs",
    "build:esm": "tsc -p tsconfig.build.json",
    "build:cjs": "tsc -p tsconfig.build.cjs.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:package": "node scripts/verify-package-exports.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build && npm run verify:package",
    "check:full": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage && npm run build && npm run verify:package",
    "prepublishOnly": "npm run clean && npm run check:full"
  },
  "keywords": [
    "nestjs",
    "typescript",
    "authorization",
    "access-control",
    "rbac",
    "abac",
    "security",
    "api-security",
    "multi-tenant",
    "guards",
    "decorators",
    "developer-tools"
  ],
  "author": "Erick Morales",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erick9125/nest-route-policy.git"
  },
  "bugs": {
    "url": "https://github.com/erick9125/nest-route-policy/issues"
  },
  "homepage": "https://github.com/erick9125/nest-route-policy#readme",
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "reflect-metadata": ">=0.2",
    "rxjs": ">=7"
  },
  "peerDependenciesMeta": {
    "reflect-metadata": {
      "optional": true
    },
    "rxjs": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@nestjs/common": "^11.1.5",
    "@nestjs/core": "^11.1.5",
    "@nestjs/platform-express": "^11.1.5",
    "@nestjs/testing": "^11.1.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.17.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
